<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>USERS</title>
</head>
<body>
    <h2>List of all users:</h2>
    <table border="1">
        <tr>
            <th>ID</th>
            <th>USERNAME</th>
            <th>EMAIL</th>
            <th>EDIT</th>
        </tr>
        <% for(let user of users) { %>
            <tr>
                <td><%= user.id %></td>
                <td><%= user.username %></td>
                <td><%= user.email %></td>
                <td>
                    <form method="GET" action="/users/<%=user.id%>/edit">
                        <button>Edit</button>
                    </form>
                </td>
            </tr>
        <% } %>
        
    </table>
</body>
</html>
